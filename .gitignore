## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env

# Hide the background cache folder causing your crashes
.vs/
.vs

# GitHub Copilot Snapshots folder
CopilotSnapshots/
**/CopilotSnapshots/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
bin/
obj/
bld/
[Oo]ut/

# Log files
*.log
*.tlog

# Visual Studio profiler
*.psess
*.vsp
*.vspx
